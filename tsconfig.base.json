{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@velaris/config": ["packages/config/src/index.ts"],
      "@velaris/database-schema": ["database/schemas/index.ts"],
      "@velaris/domain": ["packages/domain/src/index.ts"],
      "@velaris/shared": ["packages/shared/src/index.ts"],
      "@velaris/ui": ["packages/ui/src/index.ts"]
    }
  }
}
