# Velaris Orçamentos - example environment
# Copy to a local .env file when implementation starts.
# Do not commit real credentials or secrets.

NODE_ENV=development
APP_NAME=Velaris Orçamentos
APP_LOCALE=pt-BR
APP_TIMEZONE=America/Sao_Paulo
APP_CURRENCY=BRL

WEB_PORT=5173
API_PORT=3333
CORS_ORIGIN=http://localhost:5173

# Configure only with non-versioned local values.
DATABASE_URL=
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
COOKIE_DOMAIN=

# Initial configurable defaults.
DRAFT_EXPIRATION_DAYS=10
QUOTE_VALIDITY_DAYS=7

# Provider adapters are intentionally undecided.
EMAIL_PROVIDER=stub
FILE_STORAGE_PROVIDER=stub
